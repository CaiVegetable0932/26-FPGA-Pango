<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>04100301</id>
        <display_name>Multiply-Accumulator</display_name>
        <name>28nm Multiply-Accumulator</name>
        <version>1.5</version>
        <instance>statistics_mac</instance>
        <family>Logos2</family>
        <device>PG2L100H</device>
        <package>FBG676</package>
        <speedgrade>-6</speedgrade>
        <generator version="2022.2-SP6.4" build="146967">IP Compiler</generator>
    </header>
    <param_list>
        <param>
            <name>DYN_ACC_INIT</name>
            <value>1</value>
        </param>
        <param>
            <name>DYN_ACC_ADDSUB_OP</name>
            <value>0</value>
        </param>
        <param>
            <name>ASIZE</name>
            <value>16</value>
        </param>
        <param>
            <name>BSIZE</name>
            <value>16</value>
        </param>
        <param>
            <name>PSIZE</name>
            <value>48</value>
        </param>
        <param>
            <name>A_SIGNED</name>
            <value>0</value>
        </param>
        <param>
            <name>B_SIGNED</name>
            <value>0</value>
        </param>
        <param>
            <name>ASYNC_RST</name>
            <value>1</value>
        </param>
        <param>
            <name>INREG_EN</name>
            <value>1</value>
        </param>
        <param>
            <name>PIPEREG_EN</name>
            <value>1</value>
        </param>
        <param>
            <name>ACC_ADDSUB_OP</name>
            <value>0</value>
        </param>
        <param>
            <name>ACC_INIT_VALUE</name>
            <value>48'h0</value>
        </param>
        <param>
            <name>ACC_INIT_VALUE_24</name>
            <value>24'h0</value>
        </param>
        <param>
            <name>ACC_INIT_VALUE_48</name>
            <value>48'h0</value>
        </param>
        <param>
            <name>ACC_INIT_VALUE_65</name>
            <value>65'h0</value>
        </param>
        <param>
            <name>ACC_INIT_VALUE_82</name>
            <value>82'h0</value>
        </param>
        <param>
            <name>ACC_INIT_VALUE_96</name>
            <value>96'h0</value>
        </param>
        <param>
            <name>ACC_INIT_VALUE_99</name>
            <value>99'h0</value>
        </param>
        <param>
            <name>PPWidth_12</name>
            <value>24</value>
        </param>
        <param>
            <name>PPWidth_18</name>
            <value>48</value>
        </param>
        <param>
            <name>PPWidth_65</name>
            <value>65</value>
        </param>
        <param>
            <name>PPWidth_82</name>
            <value>82</value>
        </param>
        <param>
            <name>PPWidth_99</name>
            <value>99</value>
        </param>
        <param>
            <name>OPTIMAL_TIMING</name>
            <value>0</value>
        </param>
        <param>
            <name>PIPE_STATUS</name>
            <value>2</value>
        </param>
        <param>
            <name>ASYNC_RST_BOOL</name>
            <value>1</value>
        </param>
        <param>
            <name>OPTIMAL_TIMING_BOOL</name>
            <value>0</value>
        </param>
    </param_list>
    <pin_list>
        <pin>
            <name>clk</name>
            <text>clk</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>rst</name>
            <text>rst</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>ce</name>
            <text>ce</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>a</name>
            <text>a</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>15</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>b</name>
            <text>b</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>15</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>acc_init</name>
            <text>acc_init</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>47</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>reload</name>
            <text>reload</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>p</name>
            <text>p</text>
            <dir>output</dir>
            <pos>right</pos>
            <msb>47</msb>
            <lsb>0</lsb>
        </pin>
    </pin_list>
    <synthesis>
        <script>set_option -vlog_std v2001</script>
        <script>set_option -disable_io_insertion 1</script>
    </synthesis>
    <file_list>
        <output>
            <file pathname="generate.log" format="log" description="Generate Log"/>
            <file pathname="statistics_mac_tb.v" format="verilog" description="Compiled File"/>
            <file pathname="statistics_mac_tmpl.v" format="verilog" description="Instantiation Template"/>
            <file pathname="statistics_mac_tmpl.vhdl" format="vhdl" description="Instantiation Template"/>
        </output>
        <source>
            <file pathname="rtl/ipm2l_multacc_v1_2_statistics_mac.v"/>
            <file pathname="statistics_mac.v"/>
        </source>
    </file_list>
</ip_inst>
