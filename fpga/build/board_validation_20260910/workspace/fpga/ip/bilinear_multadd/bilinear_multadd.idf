<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>04100302</id>
        <display_name>Multiply-Adder</display_name>
        <name>28nm Multiply-Adder</name>
        <version>1.5</version>
        <instance>bilinear_multadd</instance>
        <family>Logos2</family>
        <device>PG2L100H</device>
        <package>FBG676</package>
        <speedgrade>-6</speedgrade>
        <generator version="2022.2-SP6.4" build="146967">IP Compiler</generator>
    </header>
    <param_list>
        <param>
            <name>ASIZE</name>
            <value>18</value>
        </param>
        <param>
            <name>BSIZE</name>
            <value>9</value>
        </param>
        <param>
            <name>A_SIGNED</name>
            <value>0</value>
        </param>
        <param>
            <name>B_SIGNED</name>
            <value>0</value>
        </param>
        <param>
            <name>ASYNC_RST</name>
            <value>1</value>
        </param>
        <param>
            <name>OPTIMAL_TIMING</name>
            <value>0</value>
        </param>
        <param>
            <name>INREG_EN</name>
            <value>1</value>
        </param>
        <param>
            <name>PIPEREG_EN_1</name>
            <value>1</value>
        </param>
        <param>
            <name>PIPEREG_EN_2</name>
            <value>0</value>
        </param>
        <param>
            <name>PIPEREG_EN_3</name>
            <value>0</value>
        </param>
        <param>
            <name>OUTREG_EN</name>
            <value>1</value>
        </param>
        <param>
            <name>PIPE_STATUS</name>
            <value>3</value>
        </param>
        <param>
            <name>ASYNC_RST_BOOL</name>
            <value>1</value>
        </param>
        <param>
            <name>DYN_ADDSUB_OP</name>
            <value>0</value>
        </param>
        <param>
            <name>ADDSUB_OP</name>
            <value>0</value>
        </param>
        <param>
            <name>OPTIMAL_TIMING_BOOL</name>
            <value>0</value>
        </param>
    </param_list>
    <pin_list>
        <pin>
            <name>clk</name>
            <text>clk</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>rst</name>
            <text>rst</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>ce</name>
            <text>ce</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>a0</name>
            <text>a0</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>17</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>b0</name>
            <text>b0</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>8</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>a1</name>
            <text>a1</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>17</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>b1</name>
            <text>b1</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>8</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>p</name>
            <text>p</text>
            <dir>output</dir>
            <pos>right</pos>
            <msb>27</msb>
            <lsb>0</lsb>
        </pin>
    </pin_list>
    <synthesis>
        <script>set_option -vlog_std v2001</script>
        <script>set_option -disable_io_insertion 1</script>
    </synthesis>
    <file_list>
        <output>
            <file pathname="generate.log" format="log" description="Generate Log"/>
            <file pathname="bilinear_multadd_tb.v" format="verilog" description="Compiled File"/>
            <file pathname="bilinear_multadd_tmpl.v" format="verilog" description="Instantiation Template"/>
            <file pathname="bilinear_multadd_tmpl.vhdl" format="vhdl" description="Instantiation Template"/>
        </output>
        <source>
            <file pathname="rtl/ipm2l_multadd_v1_3_bilinear_multadd.v"/>
            <file pathname="bilinear_multadd.v"/>
        </source>
    </file_list>
</ip_inst>
