    <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
        <column_headers>
            <data>Command</data>
        </column_headers>
        <row>
            <data>create_clock -name REF125 -period 8.000 [get_ports ref_clk_p]</data>
        </row>
        <row>
            <data>create_generated_clock -name NET125 [get_pins {u_pll.u_gpll/CLKOUT0}]</data>
        </row>
        <row>
            <data>create_generated_clock -name PHY_SAMPLE -source [get_pins {u_pll.u_gpll/CLKOUT0}] -edges {1 2 3} -edge_shift {2 2 2} [get_ports rgmii_txc]</data>
        </row>
        <row>
            <data>set_clock_uncertainty -setup 0.100 [get_clocks {NET125 PHY_SAMPLE}]</data>
        </row>
        <row>
            <data>set_clock_uncertainty -hold 0.100 [get_clocks {NET125 PHY_SAMPLE}]</data>
        </row>
        <row>
            <data>set_output_delay -clock PHY_SAMPLE -max 1.450 [get_ports {rgmii_tx_ctl rgmii_txd[*]}]</data>
        </row>
        <row>
            <data>set_output_delay -clock PHY_SAMPLE -min -1.450 [get_ports {rgmii_tx_ctl rgmii_txd[*]}]</data>
        </row>
        <row>
            <data>set_output_delay -clock PHY_SAMPLE -clock_fall -max 1.450 -add_delay [get_ports {rgmii_tx_ctl rgmii_txd[*]}]</data>
        </row>
        <row>
            <data>set_output_delay -clock PHY_SAMPLE -clock_fall -min -1.450 -add_delay [get_ports {rgmii_tx_ctl rgmii_txd[*]}]</data>
        </row>
        <row>
            <data>set_max_delay 10.000 -to [get_ports {uart_tx phy_mdc phy_mdio phy_reset_n led[*]}]</data>
        </row>
        <row>
            <data>set_min_delay 0.000 -to [get_ports {uart_tx phy_mdc phy_mdio phy_reset_n led[*]}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_ports reset_n]</data>
        </row>
        <row>
            <data>set_false_path -from [get_ports uart_rx] -to [get_cells {u_boot.u_rx.rx_meta u_mcu.u_rx.rx_meta}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_ports phy_mdio] -to [get_cells {u_phy.u_mdio.mdio_meta}]</data>
        </row>
    </table>
