        clk             : in     vl_logic;
        reset_n         : in     vl_logic;
        line_active     : in     vl_logic;
        line_end        : in     vl_logic;
        pixel_accept    : in     vl_logic;
        sample          : in     vl_logic_vector(7 downto 0);
