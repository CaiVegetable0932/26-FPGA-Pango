# Purpose: real MINI reference and common TX clock tree. PHY_SAMPLE models
# the RTL8211F's enabled 2 ns receive delay, NOT a shifted clock on the TXC pin.
create_clock -name REF125 -period 8.000 [get_ports ref_clk_p]
create_generated_clock -name NET125 [get_pins {u_pll.u_gpll/CLKOUT0}]
create_generated_clock -name PHY_SAMPLE -source [get_pins {u_pll.u_gpll/CLKOUT0}] -edges {1 2 3} -edge_shift {2 2 2} [get_ports rgmii_txc]
# Receiver 1 ns + 0.25 ns PCB skew budget + 0.20 ns PHY delay budget. These
# budgets require scope verification at bring-up; they are not measured facts.
set_output_delay -clock PHY_SAMPLE -max 1.450 [get_ports {rgmii_tx_ctl rgmii_txd[*]}]
set_output_delay -clock PHY_SAMPLE -min -1.450 [get_ports {rgmii_tx_ctl rgmii_txd[*]}]
set_output_delay -clock PHY_SAMPLE -clock_fall -max 1.450 -add_delay [get_ports {rgmii_tx_ctl rgmii_txd[*]}]
set_output_delay -clock PHY_SAMPLE -clock_fall -min -1.450 -add_delay [get_ports {rgmii_tx_ctl rgmii_txd[*]}]
set_clock_uncertainty -setup 0.100 [get_clocks {NET125 PHY_SAMPLE}]
set_clock_uncertainty -hold 0.100 [get_clocks {NET125 PHY_SAMPLE}]
# Asynchronous physical reset only; internal synchronizer release stays timed.
set_false_path -from [get_ports reset_n]
# UART and MDIO are deliberately oversampled asynchronous inputs. Cut only
# the pad-to-FIRST synchronizer flop, never the second stage or packet datapath.
set_false_path -from [get_ports uart_rx] -to [get_cells {u_boot.u_rx.rx_meta u_mcu.u_rx.rx_meta}]
set_false_path -from [get_ports phy_mdio] -to [get_cells {u_phy.u_mdio.mdio_meta}]
# Slow status/control pins: bound output routing to 10 ns. MDIO setup/hold is
# generated by 504 ns half-cycles and late-high input sampling, tested at 300 ns
# PHY delay. These are not source-synchronous 125 MHz peripheral interfaces.
set_max_delay 10.000 -to [get_ports {uart_tx phy_mdc phy_mdio phy_reset_n led[*]}]
set_min_delay 0.000 -to [get_ports {uart_tx phy_mdc phy_mdio phy_reset_n led[*]}]
