# Purpose: PDS retains ONE RCF, so this geometry-specific file first preserves
# every project-native priority from constraints/mini_camera_diag/routing.rcf.
# The build preflight checks that none of those commands is omitted.
def_route -prior_net {I_ips_ddr_top/u_ddrphy_top/ddrphy_ioclk_gate [0]}
def_route -prior_net {I_ips_ddr_top/u_ddrphy_top/ddrphy_ioclk_gate [1]}
def_route -prior_net {u_hdmi_tx/g_data_lanes[0].u_data_lane/lane_reset}
def_route -prior_net {u_hdmi_tx/g_data_lanes[1].u_data_lane/lane_reset}
def_route -prior_net {u_hdmi_tx/g_data_lanes[2].u_data_lane/lane_reset}
def_route -prior_net {u_hdmi_tx/u_clock_lane/lane_reset}
# Purpose: the 2026-10-07 timing-first candidate has positive write setup but
# a fast-corner TS_CTRL[5] hold failure. Remove ONLY the former two extra
# write-control priorities so the native multi-corner router can reconsider
# those routes. All six inherited DDR/HDMI priorities above remain intact;
# no route is fixed and no clock/PHY phase, budget or timing exception changes.
