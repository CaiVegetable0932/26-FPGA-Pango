# Purpose: full-board clocks; native DDR file defines 125 MHz ddrphy_sysclk.
create_clock -name sys_clk -period 37.037037 [get_ports sys_clk]
# Conservative internal PCLK budget above nominal 84 MHz. Datasheet table 8-5
# does NOT specify DVP pad data skew; external setup/hold remains a bring-up gate.
create_clock -name camera_pclk_budget -period 10.000 [get_ports camera_clk_0]
create_generated_clock -name serial_clk [get_pins {u_video_pll.u_gpll/CLKOUT1}]
create_generated_clock -name pixel_clk [get_pins {u_hdmi_pixel_div/CLKDIVOUT}]
# The independent networking PLL and native packet FIFO avoid exporting the
# HMIC feedback clock. Keep the board-proven forwarded-clock/TXID model.
create_generated_clock -name ETH125 [get_pins {u_eth_pll.u_gpll/CLKOUT0}]
create_generated_clock -name PHY_SAMPLE -source [get_pins {u_eth_pll.u_gpll/CLKOUT0}] -edges {1 2 3} -edge_shift {2 2 2} [get_ports rgmii_txc]
# Same board-proven PHY TXID=2ns model and unmeasured PCB/delay budgets.
set_output_delay -clock PHY_SAMPLE -max 1.450 [get_ports {rgmii_tx_ctl rgmii_txd[*]}]
set_output_delay -clock PHY_SAMPLE -min -1.450 [get_ports {rgmii_tx_ctl rgmii_txd[*]}]
set_output_delay -clock PHY_SAMPLE -clock_fall -max 1.450 -add_delay [get_ports {rgmii_tx_ctl rgmii_txd[*]}]
set_output_delay -clock PHY_SAMPLE -clock_fall -min -1.450 -add_delay [get_ports {rgmii_tx_ctl rgmii_txd[*]}]
set_clock_uncertainty -setup 0.100 [get_clocks {ETH125 PHY_SAMPLE}]
set_clock_uncertainty -hold 0.100 [get_clocks {ETH125 PHY_SAMPLE}]
# Bound forwarding-cell CLK-to-pad delay; prevents unreviewed delay insertion
# on TXC, whose actual latency is also included in both PHY_SAMPLE edge checks.
set_max_delay 2.100 -datapath_only -from [get_pins {u_rgmii.u_txc_oddr/CLK}] -to [get_ports rgmii_txc]
# Only external async reset and first-stage oversampled input exceptions.
set_false_path -from [get_ports rst_in]
set_false_path -from [get_ports uart_rx] -to [get_cells {u_boot.u_rx.rx_meta u_mcu.u_rx.rx_meta}]
set_false_path -from [get_ports phy_mdio] -to [get_cells {u_phy.u_mdio.mdio_meta}]
# 20 ns board-output routing ceiling remains far below UART 8.68us/bit and
# MDIO 504ns half-period. It is not an RGMII data timing relaxation.
set_max_delay 20.000 -to [get_ports {uart_tx phy_mdc phy_mdio phy_reset_n led[*] SCL_0 SDA_0 cam_rst_0}]
set_min_delay 0.000 -to [get_ports {uart_tx phy_mdc phy_mdio phy_reset_n led[*] SCL_0 SDA_0 cam_rst_0}]
