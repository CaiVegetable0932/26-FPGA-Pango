# Purpose: preserve only the two DDR PHY priority nets supplied by the native
# controller flow. PDS packs OSERDES reset logic without guessed hierarchy rules.
def_route -prior_net {I_ips_ddr_top/u_ddrphy_top/ddrphy_ioclk_gate [0]}
def_route -prior_net {I_ips_ddr_top/u_ddrphy_top/ddrphy_ioclk_gate [1]}
