# Purpose: audited first-stage CDC bounds, not whole-clock-domain exclusions.
# 6 ns is below both the 8 ns DDR clock and provisional 10 ns DVP clock.
# Native Gray pointers may cross asynchronously, but their routing must remain bounded.
set_max_delay 6.0 -datapath_only -from [get_cells {frame_read_write_inst0.write_buf.U_ipm2l_fifo_afifo_16i_64o_512.U_ipm2l_fifo_ctrl.ASYN_CTRL.wptr*}] -to [get_cells {frame_read_write_inst0.write_buf.U_ipm2l_fifo_afifo_16i_64o_512.U_ipm2l_fifo_ctrl.ASYN_CTRL.rwptr1*}]
set_false_path -hold -from [get_cells {frame_read_write_inst0.write_buf.U_ipm2l_fifo_afifo_16i_64o_512.U_ipm2l_fifo_ctrl.ASYN_CTRL.wptr*}] -to [get_cells {frame_read_write_inst0.write_buf.U_ipm2l_fifo_afifo_16i_64o_512.U_ipm2l_fifo_ctrl.ASYN_CTRL.rwptr1*}]
set_max_delay 6.0 -datapath_only -from [get_cells {frame_read_write_inst0.write_buf.U_ipm2l_fifo_afifo_16i_64o_512.U_ipm2l_fifo_ctrl.ASYN_CTRL.rptr*}] -to [get_cells {frame_read_write_inst0.write_buf.U_ipm2l_fifo_afifo_16i_64o_512.U_ipm2l_fifo_ctrl.ASYN_CTRL.wrptr1*}]
set_false_path -hold -from [get_cells {frame_read_write_inst0.write_buf.U_ipm2l_fifo_afifo_16i_64o_512.U_ipm2l_fifo_ctrl.ASYN_CTRL.rptr*}] -to [get_cells {frame_read_write_inst0.write_buf.U_ipm2l_fifo_afifo_16i_64o_512.U_ipm2l_fifo_ctrl.ASYN_CTRL.wrptr1*}]
set_max_delay 6.0 -datapath_only -from [get_cells {frame_read_write_inst0.read_buf.U_ipm2l_fifo_afifo_64i_16o_128.U_ipm2l_fifo_ctrl.ASYN_CTRL.wptr*}] -to [get_cells {frame_read_write_inst0.read_buf.U_ipm2l_fifo_afifo_64i_16o_128.U_ipm2l_fifo_ctrl.ASYN_CTRL.rwptr1*}]
set_false_path -hold -from [get_cells {frame_read_write_inst0.read_buf.U_ipm2l_fifo_afifo_64i_16o_128.U_ipm2l_fifo_ctrl.ASYN_CTRL.wptr*}] -to [get_cells {frame_read_write_inst0.read_buf.U_ipm2l_fifo_afifo_64i_16o_128.U_ipm2l_fifo_ctrl.ASYN_CTRL.rwptr1*}]
set_max_delay 6.0 -datapath_only -from [get_cells {frame_read_write_inst0.read_buf.U_ipm2l_fifo_afifo_64i_16o_128.U_ipm2l_fifo_ctrl.ASYN_CTRL.rptr*}] -to [get_cells {frame_read_write_inst0.read_buf.U_ipm2l_fifo_afifo_64i_16o_128.U_ipm2l_fifo_ctrl.ASYN_CTRL.wrptr1*}]
set_false_path -hold -from [get_cells {frame_read_write_inst0.read_buf.U_ipm2l_fifo_afifo_64i_16o_128.U_ipm2l_fifo_ctrl.ASYN_CTRL.rptr*}] -to [get_cells {frame_read_write_inst0.read_buf.U_ipm2l_fifo_afifo_64i_16o_128.U_ipm2l_fifo_ctrl.ASYN_CTRL.wrptr1*}]
# Purpose: synchronize only single-bit requests/status/ACKs; second stages remain timed.
set_max_delay 6.0 -datapath_only -to [get_cells {u_frame_pool.camera_meta}]
set_false_path -hold -to [get_cells {u_frame_pool.camera_meta}]
set_max_delay 6.0 -datapath_only -to [get_cells {u_frame_pool.display_meta}]
set_false_path -hold -to [get_cells {u_frame_pool.display_meta}]
set_max_delay 6.0 -datapath_only -to [get_cells {cmos_write_req_gen_inst0.ack_meta}]
set_false_path -hold -to [get_cells {cmos_write_req_gen_inst0.ack_meta}]
set_max_delay 6.0 -datapath_only -to [get_cells {video_rect_read_data_inst0.ack_meta}]
set_false_path -hold -to [get_cells {video_rect_read_data_inst0.ack_meta}]
set_max_delay 6.0 -datapath_only -to [get_cells {camera_inst0.camera_data_u.cfg_meta}]
set_false_path -hold -to [get_cells {camera_inst0.camera_data_u.cfg_meta}]
set_max_delay 6.0 -datapath_only -to [get_cells {camera_inst0.camera_data_u.ddr_meta}]
set_false_path -hold -to [get_cells {camera_inst0.camera_data_u.ddr_meta}]
set_max_delay 6.0 -datapath_only -to [get_cells {display_valid_meta}]
set_false_path -hold -to [get_cells {display_valid_meta}]
# Purpose: bound reset exceptions to the actual driver and receiving reset chain.
# PDS flattening removes module-port through points (STA-3015); register endpoints
# survive mapping. These drivers connect ONLY to receiving asynchronous reset,
# never to the shift data. All stage-to-stage and final-stage fanout remain timed.
set_false_path -from [get_cells {u_video_start.rs_ref.stages*}] -to [get_cells {camera_inst0.rs_capture.stages* u_video_start.pixel_ready_meta u_video_start.pixel_stages*}]
# Only the ready decode feeds pixel stage zero; later stages stay normally timed.
set_max_delay 6.0 -datapath_only -from [get_cells {u_video_start.start_count*}] -to [get_cells {u_video_start.pixel_ready_meta}]
set_false_path -hold -from [get_cells {u_video_start.start_count*}] -to [get_cells {u_video_start.pixel_ready_meta}]
set_false_path -from [get_cells {rs_mem.stages* frame_read_write_inst0.frame_fifo_write_m0.fifo_aclr frame_read_write_inst0.frame_fifo_write_m0.write_req_ack}] -to [get_cells {frame_read_write_inst0.rs_capture_fifo.stages* frame_read_write_inst0.rs_write_mem.stages*}]
set_false_path -from [get_cells {rs_mem.stages* frame_read_write_inst0.frame_fifo_read_m0.fifo_aclr frame_read_write_inst0.frame_fifo_read_m0.read_req_ack}] -to [get_cells {frame_read_write_inst0.rs_display_fifo.stages* frame_read_write_inst0.rs_read_mem.stages*}]
