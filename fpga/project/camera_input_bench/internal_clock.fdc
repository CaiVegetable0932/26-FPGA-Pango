# Purpose: 100MHz provisional INTERNAL benchmark; no fictitious external DVP input delays.
create_clock -name input_internal_budget -period 10.000 [get_ports clk]
# Only the genuinely asynchronous external reset assertion is excluded. Internal release remains timed.
set_false_path -from [get_ports rst_in]
# External bench controls/output ports remain outside the declared internal timing coverage.
