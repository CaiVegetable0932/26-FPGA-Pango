(_flow fab_demo "2022.2-SP6.4"
    (_comment "PG2L100H video integration baseline; generated-IP instances are kept under fpga/ip")
    (_version "1.1.0")
    (_status "initial")
    (_project
        (_option prj_work_dir (_string "."))
        (_option prj_impl_dir (_string "."))
    )
    (_task tsk_setup
        (_widget wgt_select_arch
            (_input
                (_part
                    (_family Logos2)
                    (_device PG2L100H)
                    (_speedgrade -6)
                    (_package FBG676)
                )
            )
        )
        (_widget wgt_my_design_src
            (_input
                (_file "../../rtl/pango_video_top.v" + "pango_video_top" (_format verilog))
                (_file "../../rtl/pango_ip_inventory.v" (_format verilog))
            )
        )
        (_widget wgt_my_ips_src
            (_input
                (_ip "../../ip/pll_100h/pll.idf"
                    (_ip_source_item "../../ip/pll_100h/pll.v")
                )
                (_ip "../../ip/line_fifo_100h/fifo_test.idf"
                    (_ip_source_item "../../ip/line_fifo_100h/rtl/ipm2l_fifo_ctrl_v1_1_fifo_test.v")
                    (_ip_source_item "../../ip/line_fifo_100h/rtl/ipm2l_sdpram_v1_10_fifo_test.v")
                    (_ip_source_item "../../ip/line_fifo_100h/rtl/ipm2l_fifo_v1_10_fifo_test.v")
                    (_ip_source_item "../../ip/line_fifo_100h/fifo_test.v")
                )
                (_ip "../../ip/line_ram_100h/ram_test.idf"
                    (_ip_source_item "../../ip/line_ram_100h/rtl/ipm2l_sdpram_v1_10_ram_test.v")
                    (_ip_source_item "../../ip/line_ram_100h/ram_test.v")
                )
                (_ip "../../ip/ddr3_100h/ddr3_test.idf")
            )
        )
        (_widget wgt_import_logic_con_file
            (_input
                (_file "../../constraints/pango_video_top.fdc" (_format fdc))
            )
        )
        (_widget wgt_edit_user_cons
            (_attribute _click_to_run (_switch ON))
        )
        (_widget wgt_simulation
            (_option target (_string "ModelSim Simulator"))
            (_option corner (_string "slow"))
        )
    )
    (_task tsk_compile
        (_command cmd_compile (_gci_state (_integer 0)))
    )
    (_task tsk_synthesis
        (_command cmd_synthesize
            (_gci_state (_integer 0))
            (_option selected_syn_tool_opt (_integer 2))
        )
    )
    (_task tsk_devmap
        (_command cmd_devmap (_gci_state (_integer 0)))
    )
    (_task tsk_pnr
        (_command cmd_pnr (_gci_state (_integer 0)))
        (_command cmd_report_post_pnr_timing (_gci_state (_integer 0)))
        (_command cmd_report_power (_gci_state (_integer 0)))
        (_command cmd_gen_netlist (_gci_state (_integer 0)))
    )
    (_task tsk_gen_bitstream
        (_command cmd_gen_bitstream (_gci_state (_integer 0)))
    )
)
