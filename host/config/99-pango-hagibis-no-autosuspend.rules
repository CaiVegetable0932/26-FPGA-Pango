# Temporary cold-plug diagnostic for this one physical Hagibis card.
# Install only in /run/udev/rules.d: reboot removes the exception.
# Keep delay=-1 as well as control=on: a later driver probe may enable
# autosuspend again, but this card must never reach its first runtime suspend.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1de1", ATTR{idProduct}=="f105", ATTR{product}=="Hagibis", ATTR{serial}=="-602393270", TEST=="power/control", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1", ATTR{power/control}="on"
